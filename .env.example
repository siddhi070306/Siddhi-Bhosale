# Copy to .env and fill in. Real environment variables override this file.
# LLM is REQUIRED for graph building (set one of these). Groq is tried first.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# ZENITH_LLM_PROVIDER=groq            # or openrouter
# ZENITH_GROQ_MODEL=openai/gpt-oss-120b
# ZENITH_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# ZENITH_REQUIRE_LLM=1                # set 0 only for offline rules-only runs / tests
# Official FRED API key (https://fredaccount.stlouisfed.org/apikeys); without it the public CSV download is used
FRED_API_KEY=
# NewsAPI key (https://newsapi.org); without it public RSS feeds are used
NEWSAPI_KEY=
# Contact string sent in the SEC EDGAR User-Agent header (SEC requires one)
ZENITH_SEC_CONTACT=gauravchau2412@gmail.com

# Upstash Serverless Redis (optional cloud cache for Render/Vercel: https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
